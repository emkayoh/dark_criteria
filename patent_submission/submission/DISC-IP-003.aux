\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}The variable projection loop}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The variable projection search loop. Only the two nonlinear parameters $(\tau ,\alpha )$ are searched (purple); the intercept and coefficients $(ct, cc, S2)$ are obtained analytically at every candidate (teal).}}{3}{}\protected@file@percent }
\newlabel{fig:loop}{{2}{3}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Exhaustive search over the $(\tau ,\alpha )$ plane. Each cell costs a single closed-form solve, so the whole grid is evaluated and the fit is deterministic and reproducible. Shading is illustrative.}}{4}{}\protected@file@percent }
\newlabel{fig:grid}{{3}{4}}
